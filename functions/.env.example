APP_URL=https://paperbridge.web.app
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
EMAIL_FROM=
EMAIL_REPLY_TO=
# App-wide SMTP attempt caps; queue excess until reset. 0 pauses that window.
EMAIL_HOURLY_LIMIT=50
EMAIL_DAILY_LIMIT=250
EMAIL_MONTHLY_LIMIT=7000
# PAPERBRIDGE_AI_KEY_ENCRYPTION_KEY and PAPERBRIDGE_SMTP_PASSWORD belong in Secret Manager, not this file.

# Required for production isolation in a shared Firebase project.
PAPERBRIDGE_DATABASE_ID=paperbridge
PAPERBRIDGE_AUTH_TENANT_ID=
PAPERBRIDGE_STORAGE_BUCKET=
PAPERBRIDGE_SERVICE_ACCOUNT=
