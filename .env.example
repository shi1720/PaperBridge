# Firebase web configuration is public, but deployment values are kept environment-specific.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=paperbridge-research.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=paperbridge-research
VITE_FIREBASE_STORAGE_BUCKET=paperbridge-research.firebasestorage.app
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false
# Set true only after backend, Auth, Storage and real email delivery pass production verification.
VITE_SERVICE_READY=false
VITE_GOOGLE_AUTH_ENABLED=false
